// Schema del database per il sistema di gestione società di calcio
// Versione: 4.0.0 - Schema completo e allineato con tutti i componenti

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// MODELLI PRINCIPALI
// ==========================================

// Organizzazione (Società di calcio)
model Organization {
  id        String   @id @default(uuid())
  name      String
  taxCode   String?  @unique
  address   String?
  city      String?
  province  String?
  zipCode   String?
  email     String?
  phone     String?
  website   String?
  logo      String?
  foundedYear        Int?
  president          String?
  colors             String[]
  registrationNumber String?
  bankAccount        String?
  socialLinks        Json?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relazioni
  users              User[]
  athletes           Athlete[]
  teams              Team[]
  documents          Document[]
  payments           Payment[]
  matches            Match[]
  trainings          TrainingSession[]
  transportZones     TransportZone[]
  transportRoutes    TransportRoute[]
  notifications      Notification[]
  notificationTemplates NotificationTemplate[]
  organizationSettings OrganizationSettings?
  auditLogs          AuditLog[]
  emailLogs          EmailLog[]
  competitions       Competition[]
  venues             Venue[]
  staffMembers       Staff[]
  sponsors           Sponsor[]
  injuries           Injury[]

  @@map("organizations")
}

// Utenti del sistema
model User {
  id             String    @id @default(uuid())
  email          String    @unique
  password       String
  firstName      String
  lastName       String
  phone          String?
  role           Role      @relation(fields: [roleId], references: [id])
  roleId         String
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  isActive       Boolean   @default(true)
  emailVerified  Boolean   @default(false)
  lastLogin      DateTime?
  
  // Preferenze notifiche (JSON)
  preferences    Json?     @default("{}")
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relazioni
  createdPayments   Payment[]  @relation("CreatedBy")
  notifications     Notification[]
  auditLogs         AuditLog[]

  @@index([email])
  @@index([organizationId])
  @@map("users")
}

// Ruoli utente
model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  organizationId String? // Per ruoli specifici dell'organizzazione
  permissions Json?    // Array di permessi
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relazioni
  users User[]

  @@map("roles")
}

// Atleti
model Athlete {
  id             String        @id @default(uuid())
  firstName      String
  lastName       String
  birthDate      DateTime
  birthPlace     String?
  nationality    String        @default("Italiana")
  fiscalCode     String?       @unique
  email          String?
  phone          String?
  address        String?
  city           String?
  province       String?
  zipCode        String?
  
  // Dati sportivi
  team           Team?         @relation(fields: [teamId], references: [id])
  teamId         String?
  position       Position?     @relation(fields: [positionId], references: [id])
  positionId     String?
  jerseyNumber   Int?
  status         AthleteStatus @default(ACTIVE)
  height         Int?          // in cm
  weight         Int?          // in kg
  footPreference String?       // RIGHT, LEFT, BOTH
  
  // Trasporti
  transportZone        TransportZone? @relation(fields: [transportZoneId], references: [id])
  transportZoneId      String?
  hasTransportService  Boolean       @default(false)
  
  // Dati genitori/tutori
  parentName     String?
  parentPhone    String?
  parentEmail    String?
  
  // Dati medici
  medicalNotes   String?
  allergies      String?
  
  // Note
  notes          String?
  
  organization   Organization  @relation(fields: [organizationId], references: [id])
  organizationId String
  
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Relazioni
  documents      Document[]
  payments       Payment[]
  attendances    TrainingAttendance[]
  matchRoster    MatchRoster[]
  matchStats     MatchStats[]
  injuries       Injury[]
  transportBookings TransportBooking[]

  @@index([organizationId])
  @@index([teamId])
  @@index([fiscalCode])
  @@map("athletes")
}

// Stati atleta
enum AthleteStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  INJURED
}

// Squadre
model Team {
  id             String       @id @default(uuid())
  name           String
  category       String       // Es: "U12", "U14", ecc.
  season         String       // Es: "2024/2025"
  coachId        String?      // ID dell'allenatore principale (da Staff)
  
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relazioni
  athletes       Athlete[]
  homeMatches    Match[]      @relation("HomeTeam")
  awayMatches    Match[]      @relation("AwayTeam")
  trainings      TrainingSession[]
  staffMembers   Staff[]

  @@index([organizationId])
  @@map("teams")
}

// Posizioni di gioco
model Position {
  id          String    @id @default(uuid())
  name        String    @unique
  abbreviation String?  // Es: "POR", "DIF", "CEN", "ATT"
  description String?

  // Relazioni
  athletes    Athlete[]

  @@map("positions")
}

// ==========================================
// GESTIONE DOCUMENTI
// ==========================================

// Tipi di documento
model DocumentType {
  id           Int        @id @default(autoincrement())
  name         String     @unique
  description  String?
  isRequired   Boolean    @default(false)
  hasExpiry    Boolean    @default(false)
  validityDays Int?       // Giorni di validità predefiniti

  // Relazioni
  documents    Document[]

  @@map("document_types")
}

// Documenti
model Document {
  id             String         @id @default(uuid())
  athlete        Athlete        @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  athleteId      String
  type           DocumentType   @relation(fields: [typeId], references: [id])
  typeId         Int
  fileName       String
  fileUrl        String
  fileSize       Int
  mimeType       String
  issueDate      DateTime?
  expiryDate     DateTime?
  status         DocumentStatus @default(VALID)
  notes          String?
  
  // Tracking upload e verifica
  uploadedBy     String?        // ID utente che ha caricato
  uploadedAt     DateTime       @default(now())
  isVerified     Boolean        @default(false)
  verifiedBy     String?        // ID utente che ha verificato
  verifiedAt     DateTime?
  
  organization   Organization   @relation(fields: [organizationId], references: [id])
  organizationId String
  
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([athleteId])
  @@index([organizationId])
  @@index([expiryDate])
  @@map("documents")
}

// Stati documento
enum DocumentStatus {
  VALID
  EXPIRING
  EXPIRED
}

// ==========================================
// GESTIONE PAGAMENTI
// ==========================================

// Tipi di pagamento
model PaymentType {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  amount      Float     @default(0)
  isRecurring Boolean   @default(false)
  frequency   String?   // MONTHLY, YEARLY, ONE_TIME
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relazioni
  payments    Payment[]

  @@map("payment_types")
}

// Pagamenti
model Payment {
  id             String         @id @default(uuid())
  organization   Organization   @relation(fields: [organizationId], references: [id])
  organizationId String
  athlete        Athlete        @relation(fields: [athleteId], references: [id])
  athleteId      String
  type           PaymentType    @relation(fields: [typeId], references: [id])
  typeId         Int
  amount         Float
  paidAmount     Float?         @default(0)
  dueDate        DateTime
  paidDate       DateTime?
  status         PaymentStatus  @default(PENDING)
  paymentMethod  String?
  description    String?
  notes          String?
  createdBy      User          @relation("CreatedBy", fields: [createdById], references: [id])
  createdById    String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId])
  @@index([athleteId])
  @@index([status])
  @@index([dueDate])
  @@map("payments")
}

// Stati pagamento
enum PaymentStatus {
  PENDING
  PAID
  PARTIAL
  OVERDUE
  CANCELLED
}

// ==========================================
// GESTIONE PARTITE E ALLENAMENTI
// ==========================================

// Competizioni
model Competition {
  id             String       @id @default(uuid())
  name           String
  type           String       // CAMPIONATO, COPPA, TORNEO, AMICHEVOLE
  category       String       // U12, U14, U16, etc.
  season         String
  startDate      DateTime
  endDate        DateTime?
  description    String?
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relazioni
  matches        Match[]

  @@map("competitions")
}

// Campi da gioco
model Venue {
  id             String       @id @default(uuid())
  name           String
  address        String
  city           String
  province       String?
  capacity       Int?
  type           String       @default("HOME") // HOME, AWAY, NEUTRAL
  isHome         Boolean      @default(false) // Campo di casa
  surface        String?      // ERBA_NATURALE, ERBA_SINTETICA, TERRA
  hasLighting    Boolean      @default(false)
  notes          String?      // Note aggiuntive
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relazioni
  matches        Match[]

  @@map("venues")
}

// Partite
model Match {
  id              String        @id @default(uuid())
  homeTeam        Team?         @relation("HomeTeam", fields: [homeTeamId], references: [id])
  homeTeamId      String
  awayTeam        Team?         @relation("AwayTeam", fields: [awayTeamId], references: [id])
  awayTeamId      String
  date            DateTime
  time            String?       // Orario separato
  venue           Venue?        @relation(fields: [venueId], references: [id])
  venueId         String?
  competition     Competition?  @relation(fields: [competitionId], references: [id])
  competitionId   String?
  matchType       String        @default("CAMPIONATO") // CAMPIONATO, COPPA, AMICHEVOLE, TORNEO
  
  // Risultato
  homeScore       Int?
  awayScore       Int?
  status          MatchStatus   @default(SCHEDULED)
  
  // Dettagli aggiuntivi
  isHome          Boolean       @default(true)
  opponentName    String?       // Nome squadra avversaria se esterna
  notes           String?
  
  organization    Organization  @relation(fields: [organizationId], references: [id])
  organizationId  String
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relazioni
  roster          MatchRoster[]
  stats           MatchStats[]
  transportSchedules TransportSchedule[]

  @@index([organizationId])
  @@index([date])
  @@map("matches")
}

// Stati partita
enum MatchStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  POSTPONED
}

// Convocazioni partita
model MatchRoster {
  id        String   @id @default(uuid())
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchId   String
  athlete   Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  athleteId String
  position  String?  // Posizione in campo per questa partita
  isStarter Boolean  @default(false)
  isPresent Boolean? // Presenza effettiva
  notes     String?

  @@unique([matchId, athleteId])
  @@map("match_rosters")
}

// Statistiche partita per atleta
model MatchStats {
  id          String  @id @default(uuid())
  match       Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchId     String
  athlete     Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  athleteId   String
  minutesPlayed Int   @default(0)
  goals       Int     @default(0)
  assists     Int     @default(0)
  yellowCards Int     @default(0)
  redCards    Int     @default(0)
  notes       String?

  @@unique([matchId, athleteId])
  @@map("match_stats")
}

// Sessioni di allenamento
model TrainingSession {
  id             String       @id @default(uuid())
  team           Team         @relation(fields: [teamId], references: [id])
  teamId         String
  date           DateTime
  startTime      String
  endTime        String
  location       String?
  type           String?      // TECNICO, TATTICO, FISICO, PARTITA
  description    String?
  notes          String?
  
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relazioni
  attendances    TrainingAttendance[]
  transportSchedules TransportSchedule[]

  @@index([teamId])
  @@index([date])
  @@map("training_sessions")
}

// Presenze allenamento
model TrainingAttendance {
  id        String          @id @default(uuid())
  session   TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  athlete   Athlete         @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  athleteId String
  present   Boolean         @default(false)
  reason    String?         // Motivo assenza
  notes     String?

  @@unique([sessionId, athleteId])
  @@map("training_attendances")
}

// ==========================================
// GESTIONE INFORTUNI
// ==========================================

model Injury {
  id                String       @id @default(uuid())
  athlete           Athlete      @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  athleteId         String
  injuryDate        DateTime
  injuryType        String?      // MUSCOLARE, DISTORSIONE, CONTUSIONE, FRATTURA, ALTRO
  bodyPart          String?      // Parte del corpo infortunata
  description       String
  severity          String?      // LIEVE, MODERATA, GRAVE
  estimatedRecoveryDays Int?     // Giorni stimati di recupero
  isRecovered       Boolean      @default(false)
  recoveryDate      DateTime?
  notes             String?
  
  organization      Organization @relation(fields: [organizationId], references: [id])
  organizationId    String
  
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([athleteId])
  @@map("injuries")
}

// ==========================================
// SISTEMA TRASPORTI
// ==========================================

model TransportZone {
  id             String       @id @default(uuid())
  name           String
  description    String?
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relazioni
  athletes       Athlete[]

  @@map("transport_zones")
}

// ==========================================
// SISTEMA NOTIFICHE
// ==========================================

model Notification {
  id             String       @id @default(uuid())
  user           User?        @relation(fields: [userId], references: [id])
  userId         String?
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  type           String       // DOCUMENT_EXPIRING, PAYMENT_OVERDUE, MATCH_REMINDER, etc.
  title          String
  message        String
  link           String?
  priority       String       @default("normal") // low, normal, high, urgent
  isRead         Boolean      @default(false)
  readAt         DateTime?
  data           Json?
  createdAt      DateTime     @default(now())

  @@index([userId])
  @@index([organizationId])
  @@index([isRead])
  @@map("notifications")
}

// Template notifiche personalizzabili
model NotificationTemplate {
  id             String       @id @default(uuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  name           String
  type           String       // Tipo di notifica (document_expiry, payment_overdue, etc.)
  title          String       // Template titolo con variabili {{variable}}
  message        String       // Template messaggio con variabili
  emailSubject   String?      // Template oggetto email
  emailBody      String?      // Template corpo email HTML
  variables      Json         // Array di variabili disponibili
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, type])
  @@map("notification_templates")
}

// ==========================================
// IMPOSTAZIONI E CONFIGURAZIONI
// ==========================================

// Impostazioni organizzazione
model OrganizationSettings {
  id             String       @id @default(uuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String       @unique
  
  // Email Settings
  emailProvider  String?      @default("brevo") // brevo, sendgrid, smtp
  emailApiKey    String?      // Encrypted
  emailFrom      String?      @default("noreply@soccermanager.com")
  emailFromName  String?      @default("Soccer Manager")
  emailEnabled   Boolean      @default(false)
  
  // Notification Preferences (default per nuovi utenti)
  defaultPreferences Json?    @default("{}")
  
  // Other Settings
  timezone       String       @default("Europe/Rome")
  dateFormat     String       @default("DD/MM/YYYY")
  currency       String       @default("EUR")
  language       String       @default("it")
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("organization_settings")
}

// ==========================================
// AUDIT E LOGGING
// ==========================================

// Audit log per tracciamento modifiche
model AuditLog {
  id             String       @id @default(uuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  user           User?        @relation(fields: [userId], references: [id])
  userId         String?
  
  action         String       // CREATE, UPDATE, DELETE, LOGIN, LOGOUT
  entityType     String       // ATHLETE, DOCUMENT, PAYMENT, etc.
  entityId       String?      // ID dell'entità modificata
  
  oldValues      Json?        // Valori precedenti
  newValues      Json?        // Nuovi valori
  
  ipAddress      String?
  userAgent      String?
  
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([userId])
  @@index([entityType])
  @@index([createdAt])
  @@map("audit_logs")
}

// Log delle email inviate
model EmailLog {
  id             String       @id @default(uuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  
  to             String       // Email destinatario
  subject        String
  body           String?      @db.Text
  
  status         String       // SENT, FAILED, BOUNCED
  provider       String?      // brevo, sendgrid, etc.
  providerId     String?      // ID del provider
  
  error          String?      // Errore se fallito
  
  sentAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([to])
  @@index([status])
  @@map("email_logs")
}

// ==========================================
// STAFF TECNICO
// ==========================================

model Staff {
  id             String       @id @default(uuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  firstName      String
  lastName       String
  role           String       // ALLENATORE, ASSISTENTE, PREPARATORE, MEDICO, FISIOTERAPISTA, DIRIGENTE
  team           Team?        @relation(fields: [teamId], references: [id])
  teamId         String?
  email          String?
  phone          String?
  licenseNumber  String?      // Numero tesserino/licenza
  licenseExpiry  DateTime?    // Scadenza licenza
  qualification  String?      // Qualifiche (es. "UEFA A", "Laurea Scienze Motorie")
  qualifications String?      // Qualifiche multiple
  startDate      DateTime?
  contractEnd    DateTime?
  salary         Float?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("staff")
}

// ==========================================
// SPONSOR
// ==========================================

model Sponsor {
  id             String       @id @default(uuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  name           String
  type           String       // MAIN, SECONDARY, TECHNICAL
  contactPerson  String?
  contactEmail   String?      // Email contatto
  contactPhone   String?      // Telefono contatto
  email          String?
  phone          String?
  website        String?
  logoUrl        String?
  amount         Float?       // Importo annuale
  status         String       @default("ACTIVE") // ACTIVE, INACTIVE, EXPIRED
  startDate      DateTime?
  endDate        DateTime?
  description    String?
  notes          String?      // Note aggiuntive
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("sponsors")
}

// ==========================================
// SISTEMA TRASPORTI COMPLETO
// ==========================================

// Route di trasporto
model TransportRoute {
  id             String       @id @default(uuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  name           String       // Nome della route (es. "Linea Centro", "Linea Nord")
  description    String?
  driver         String?      // Nome autista
  vehiclePlate   String?      // Targa veicolo
  capacity       Int          @default(8) // Capacità veicolo
  startPoint     String?      // Punto di partenza
  endPoint       String?      // Punto di arrivo
  stops          Json?        // Array di fermate intermedie
  distance       Float?       // Distanza in km
  estimatedTime  Int?         // Tempo stimato in minuti
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relazioni
  schedules      TransportSchedule[]

  @@map("transport_routes")
}

// Programmazione trasporti
model TransportSchedule {
  id             String       @id @default(uuid())
  route          TransportRoute @relation(fields: [routeId], references: [id])
  routeId        String
  
  // Collegamenti opzionali a partite o allenamenti
  match          Match?       @relation(fields: [matchId], references: [id])
  matchId        String?
  session        TrainingSession? @relation(fields: [sessionId], references: [id])
  sessionId      String?
  
  // Orari
  pickupTime     DateTime     // Orario partenza
  returnTime     DateTime?    // Orario ritorno
  
  // Dettagli trasporto
  status         String       @default("SCHEDULED") // SCHEDULED, IN_PROGRESS, COMPLETED, CANCELLED
  notes          String?
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relazioni
  bookings       TransportBooking[]

  @@map("transport_schedules")
}

// Prenotazioni trasporto
model TransportBooking {
  id             String            @id @default(uuid())
  schedule       TransportSchedule @relation(fields: [scheduleId], references: [id])
  scheduleId     String
  athlete        Athlete           @relation(fields: [athleteId], references: [id])
  athleteId      String
  bookingDate    DateTime          @default(now()) // Data della prenotazione
  pickupPoint    String?           // Punto di salita
  dropoffPoint   String?           // Punto di discesa
  status         String            @default("CONFIRMED") // CONFIRMED, CANCELLED, COMPLETED
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([scheduleId, athleteId])
  @@map("transport_bookings")
}
