generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                    String                 @id @default(uuid())
  name                  String
  taxCode               String?                @unique
  address               String?
  city                  String?
  province              String?
  zipCode               String?
  email                 String?
  phone                 String?
  website               String?
  logo                  String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  bankAccount           String?
  colors                String[]
  foundedYear           Int?
  president             String?
  registrationNumber    String?
  socialLinks           Json?
  athletes              Athlete[]
  auditLogs             AuditLog[]
  competitions          Competition[]
  documents             Document[]
  emailLogs             EmailLog[]
  injuries              Injury[]
  matches               Match[]
  notificationTemplates NotificationTemplate[]
  notifications         Notification[]
  organizationSettings  OrganizationSettings?
  payments              Payment[]
  sponsors              Sponsor[]
  staffMembers          Staff[]
  teams                 Team[]
  trainings             TrainingSession[]
  transportRoutes       TransportRoute[]
  transportZones        TransportZone[]
  users                 User[]
  venues                Venue[]

  @@map("organizations")
}

model User {
  id              String         @id @default(uuid())
  email           String         @unique
  password        String
  firstName       String
  lastName        String
  phone           String?
  roleId          String
  organizationId  String
  isActive        Boolean        @default(true)
  lastLogin       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  emailVerified   Boolean        @default(false)
  preferences     Json?          @default("{}")
  auditLogs       AuditLog[]
  notifications   Notification[]
  createdPayments Payment[]      @relation("CreatedBy")
  organization    Organization   @relation(fields: [organizationId], references: [id])
  role            Role           @relation(fields: [roleId], references: [id])

  @@index([email])
  @@index([organizationId])
  @@map("users")
}

model Role {
  id             String   @id @default(uuid())
  name           String   @unique
  description    String?
  permissions    Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organizationId String?
  users          User[]

  @@map("roles")
}

model Athlete {
  id                  String               @id @default(uuid())
  firstName           String
  lastName            String
  birthDate           DateTime
  birthPlace          String?
  nationality         String               @default("Italiana")
  fiscalCode          String?              @unique
  email               String?
  phone               String?
  address             String?
  city                String?
  province            String?
  zipCode             String?
  teamId              String?
  positionId          String?
  jerseyNumber        Int?
  status              AthleteStatus        @default(ACTIVE)
  parentName          String?
  parentPhone         String?
  parentEmail         String?
  medicalNotes        String?
  allergies           String?
  organizationId      String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  transportZoneId     String?
  footPreference      String?
  hasTransportService Boolean              @default(false)
  height              Int?
  notes               String?
  weight              Int?
  organization        Organization         @relation(fields: [organizationId], references: [id])
  position            Position?            @relation(fields: [positionId], references: [id])
  team                Team?                @relation(fields: [teamId], references: [id])
  transportZone       TransportZone?       @relation(fields: [transportZoneId], references: [id])
  documents           Document[]
  injuries            Injury[]
  matchRoster         MatchRoster[]
  matchStats          MatchStats[]
  payments            Payment[]
  attendances         TrainingAttendance[]
  transportBookings   TransportBooking[]

  @@index([organizationId])
  @@index([teamId])
  @@index([fiscalCode])
  @@map("athletes")
}

model Team {
  id             String            @id @default(uuid())
  name           String
  category       String
  season         String
  organizationId String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  coachId        String?
  athletes       Athlete[]
  awayMatches    Match[]           @relation("AwayTeam")
  homeMatches    Match[]           @relation("HomeTeam")
  staffMembers   Staff[]
  organization   Organization      @relation(fields: [organizationId], references: [id])
  trainings      TrainingSession[]

  @@index([organizationId])
  @@map("teams")
}

model Position {
  id           String    @id @default(uuid())
  name         String    @unique
  description  String?
  abbreviation String?
  athletes     Athlete[]

  @@map("positions")
}

model DocumentType {
  id           Int        @id @default(autoincrement())
  name         String     @unique
  description  String?
  isRequired   Boolean    @default(false)
  hasExpiry    Boolean    @default(false)
  validityDays Int?
  documents    Document[]

  @@map("document_types")
}

model Document {
  id             String         @id @default(uuid())
  athleteId      String
  typeId         Int
  fileName       String
  fileUrl        String
  fileSize       Int
  mimeType       String
  issueDate      DateTime?
  expiryDate     DateTime?
  status         DocumentStatus @default(VALID)
  notes          String?
  uploadedAt     DateTime       @default(now())
  isVerified     Boolean        @default(false)
  verifiedAt     DateTime?
  organizationId String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  uploadedBy     String?
  verifiedBy     String?
  athlete        Athlete        @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  organization   Organization   @relation(fields: [organizationId], references: [id])
  type           DocumentType   @relation(fields: [typeId], references: [id])

  @@index([athleteId])
  @@index([organizationId])
  @@index([expiryDate])
  @@map("documents")
}

model PaymentType {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  amount      Float     @default(0)
  isRecurring Boolean   @default(false)
  frequency   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  payments    Payment[]

  @@map("payment_types")
}

model Payment {
  id             String        @id @default(uuid())
  athleteId      String
  typeId         Int
  amount         Float
  dueDate        DateTime
  paidDate       DateTime?
  status         PaymentStatus @default(PENDING)
  paymentMethod  String?
  notes          String?
  createdById    String
  organizationId String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  description    String?
  paidAmount     Float?        @default(0)
  athlete        Athlete       @relation(fields: [athleteId], references: [id])
  createdBy      User          @relation("CreatedBy", fields: [createdById], references: [id])
  organization   Organization  @relation(fields: [organizationId], references: [id])
  type           PaymentType   @relation(fields: [typeId], references: [id])

  @@index([organizationId])
  @@index([athleteId])
  @@index([status])
  @@index([dueDate])
  @@map("payments")
}

model Competition {
  id             String       @id @default(uuid())
  name           String
  type           String
  season         String
  startDate      DateTime
  endDate        DateTime?
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  description    String?
  category       String
  organization   Organization @relation(fields: [organizationId], references: [id])
  matches        Match[]

  @@map("competitions")
}

model Venue {
  id             String       @id @default(uuid())
  name           String
  address        String
  city           String
  province       String?
  capacity       Int?
  type           String       @default("HOME")
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  hasLighting    Boolean      @default(false)
  surface        String?
  isHome         Boolean      @default(false)
  notes          String?
  matches        Match[]
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@map("venues")
}

model Match {
  id                 String              @id @default(uuid())
  homeTeamId         String
  awayTeamId         String
  date               DateTime
  time               String?
  homeScore          Int?
  awayScore          Int?
  status             MatchStatus         @default(SCHEDULED)
  notes              String?
  organizationId     String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  competitionId      String?
  venueId            String?
  isHome             Boolean             @default(true)
  matchType          String              @default("CAMPIONATO")
  opponentName       String?
  roster             MatchRoster[]
  stats              MatchStats[]
  awayTeam           Team                @relation("AwayTeam", fields: [awayTeamId], references: [id])
  competition        Competition?        @relation(fields: [competitionId], references: [id])
  homeTeam           Team                @relation("HomeTeam", fields: [homeTeamId], references: [id])
  organization       Organization        @relation(fields: [organizationId], references: [id])
  venue              Venue?              @relation(fields: [venueId], references: [id])
  transportSchedules TransportSchedule[]

  @@index([organizationId])
  @@index([date])
  @@map("matches")
}

model MatchRoster {
  id        String   @id @default(uuid())
  matchId   String
  athleteId String
  isStarter Boolean  @default(false)
  notes     String?
  isPresent Boolean?
  position  String?
  athlete   Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, athleteId])
  @@map("match_rosters")
}

model MatchStats {
  id            String  @id @default(uuid())
  matchId       String
  athleteId     String
  minutesPlayed Int     @default(0)
  goals         Int     @default(0)
  assists       Int     @default(0)
  yellowCards   Int     @default(0)
  redCards      Int     @default(0)
  notes         String?
  athlete       Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  match         Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, athleteId])
  @@map("match_stats")
}

model TrainingSession {
  id                 String               @id @default(uuid())
  teamId             String
  date               DateTime
  startTime          String
  endTime            String
  location           String?
  type               String?
  description        String?
  organizationId     String
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  notes              String?
  attendances        TrainingAttendance[]
  organization       Organization         @relation(fields: [organizationId], references: [id])
  team               Team                 @relation(fields: [teamId], references: [id])
  transportSchedules TransportSchedule[]

  @@index([teamId])
  @@index([date])
  @@map("training_sessions")
}

model TrainingAttendance {
  id        String          @id @default(uuid())
  sessionId String
  athleteId String
  present   Boolean         @default(false)
  reason    String?
  notes     String?
  athlete   Athlete         @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  session   TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, athleteId])
  @@map("training_attendances")
}

model Injury {
  id                    String       @id @default(uuid())
  athleteId             String
  injuryDate            DateTime
  description           String
  severity              String?
  isRecovered           Boolean      @default(false)
  recoveryDate          DateTime?
  notes                 String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  bodyPart              String?
  estimatedRecoveryDays Int?
  injuryType            String?
  organizationId        String
  athlete               Athlete      @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  organization          Organization @relation(fields: [organizationId], references: [id])

  @@index([athleteId])
  @@map("injuries")
}

model TransportZone {
  id             String       @id @default(uuid())
  name           String
  description    String?
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  athletes       Athlete[]
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@map("transport_zones")
}

model Notification {
  id             String       @id @default(uuid())
  userId         String?
  organizationId String
  type           String
  title          String
  message        String
  link           String?
  priority       String       @default("normal")
  isRead         Boolean      @default(false)
  readAt         DateTime?
  data           Json?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User?        @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([organizationId])
  @@index([isRead])
  @@map("notifications")
}

model NotificationTemplate {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  type           String
  title          String
  message        String
  emailSubject   String?
  emailBody      String?
  variables      Json
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, type])
  @@map("notification_templates")
}

model OrganizationSettings {
  id                 String       @id @default(uuid())
  organizationId     String       @unique
  emailProvider      String?      @default("brevo")
  emailApiKey        String?
  emailFrom          String?      @default("noreply@soccermanager.com")
  emailFromName      String?      @default("Soccer Manager")
  emailEnabled       Boolean      @default(false)
  defaultPreferences Json?        @default("{}")
  timezone           String       @default("Europe/Rome")
  dateFormat         String       @default("DD/MM/YYYY")
  currency           String       @default("EUR")
  language           String       @default("it")
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  organization       Organization @relation(fields: [organizationId], references: [id])

  @@map("organization_settings")
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  userId         String?
  action         String
  entityType     String
  entityId       String?
  oldValues      Json?
  newValues      Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User?        @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@index([entityType])
  @@index([createdAt])
  @@map("audit_logs")
}

model EmailLog {
  id             String       @id @default(uuid())
  organizationId String
  to             String
  subject        String
  body           String?
  status         String
  provider       String?
  providerId     String?
  error          String?
  sentAt         DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([to])
  @@index([status])
  @@map("email_logs")
}

model Staff {
  id                       String       @id @default(uuid())
  organizationId           String
  firstName                String
  lastName                 String
  role                     String?
  teamId                   String?
  email                    String?
  phone                    String?
  qualification            String?
  startDate                DateTime?
  contractEnd              DateTime?
  salary                   Float?
  isActive                 Boolean      @default(true)
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt
  licenseExpiry            DateTime?
  licenseNumber            String?
  qualifications           String?
  address                  String?
  allergies                String?
  birthDate                DateTime?
  birthPlace               String?
  bloodType                String?
  canAccessSystem          Boolean      @default(false)
  canManageAthletes        Boolean      @default(false)
  canManageDocuments       Boolean      @default(false)
  canManagePayments        Boolean      @default(false)
  canSendNotifications     Boolean      @default(false)
  canViewReports           Boolean      @default(false)
  city                     String?
  contractStart            DateTime?
  contractType             String       @default("VOLUNTEER")
  criminalCheckDate        DateTime?
  criminalCheckExpiry      DateTime?
  deletedAt                DateTime?
  emergencyContact         String?
  emergencyPhone           String?
  fiscalCode               String?
  hasCriminalCheck         Boolean      @default(false)
  hasMedicalCertificate    Boolean      @default(false)
  licenseType              String?
  medicalCertificateDate   DateTime?
  medicalCertificateExpiry DateTime?
  medicalNotes             String?
  mobile                   String?
  nationality              String       @default("Italiana")
  notes                    String?
  paymentFrequency         String?
  permissions              Json?
  primaryTeamId            String?
  profilePhoto             String?
  province                 String?
  specialization           String?
  staffRole                String?
  status                   String       @default("ACTIVE")
  tags                     String[]
  teamIds                  String[]
  zipCode                  String?
  userId                   String?
  organization             Organization @relation(fields: [organizationId], references: [id])
  team                     Team?        @relation(fields: [teamId], references: [id])

  @@index([organizationId])
  @@index([teamId])
  @@index([staffRole])
  @@index([status])
  @@index([userId])
  @@map("staff")
}

model Sponsor {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  type           String
  contactPerson  String?
  email          String?
  phone          String?
  website        String?
  logoUrl        String?
  amount         Float?
  startDate      DateTime?
  endDate        DateTime?
  description    String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  contactEmail   String?
  contactPhone   String?
  notes          String?
  status         String       @default("ACTIVE")
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@map("sponsors")
}

model TrainingSession {
  id             String              @id @default(uuid())
  organizationId String
  teamId         String
  date           DateTime
  type           String?             @default("Allenamento")
  location       String?             @default("Campo principale")
  notes          String?
  status         String              @default("SCHEDULED")
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  
  organization   Organization        @relation(fields: [organizationId], references: [id])
  team           Team                @relation(fields: [teamId], references: [id])
  attendances    TrainingAttendance[]
  schedules      TransportSchedule[]

  @@map("training_sessions")
}

model TrainingAttendance {
  id         String          @id @default(uuid())
  sessionId  String
  athleteId  String
  present    Boolean         @default(false)
  notes      String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  
  session    TrainingSession @relation(fields: [sessionId], references: [id])
  athlete    Athlete         @relation(fields: [athleteId], references: [id])

  @@unique([sessionId, athleteId])
  @@map("training_attendances")
}

model TransportRoute {
  id             String              @id @default(uuid())
  organizationId String
  name           String
  description    String?
  startPoint     String?
  endPoint       String?
  stops          Json?
  distance       Float?
  estimatedTime  Int?
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  capacity       Int                 @default(8)
  driver         String?
  vehiclePlate   String?
  organization   Organization        @relation(fields: [organizationId], references: [id])
  schedules      TransportSchedule[]

  @@map("transport_routes")
}

model TransportSchedule {
  id         String             @id @default(uuid())
  routeId    String
  notes      String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  matchId    String?
  pickupTime DateTime
  returnTime DateTime?
  sessionId  String?
  status     String             @default("SCHEDULED")
  bookings   TransportBooking[]
  match      Match?             @relation(fields: [matchId], references: [id])
  route      TransportRoute     @relation(fields: [routeId], references: [id])
  session    TrainingSession?   @relation(fields: [sessionId], references: [id])

  @@map("transport_schedules")
}

model TransportBooking {
  id           String            @id @default(uuid())
  scheduleId   String
  athleteId    String
  bookingDate  DateTime          @default(now())
  pickupPoint  String?
  dropoffPoint String?
  status       String            @default("CONFIRMED")
  notes        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  athlete      Athlete           @relation(fields: [athleteId], references: [id])
  schedule     TransportSchedule @relation(fields: [scheduleId], references: [id])

  @@unique([scheduleId, athleteId])
  @@map("transport_bookings")
}

enum AthleteStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  INJURED
}

enum DocumentStatus {
  VALID
  EXPIRING
  EXPIRED
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
  PARTIAL
}

enum MatchStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  POSTPONED
}
