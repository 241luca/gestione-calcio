// Schema del database per il sistema di gestione società di calcio
// Versione: 3.0.0 - Con tutte le funzionalità mancanti

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// MODELLI PRINCIPALI
// ==========================================

// Organizzazione (Società di calcio)
model Organization {
  id        String   @id @default(uuid())
  name      String
  taxCode   String?  @unique // Codice fiscale/P.IVA
  address   String?
  city      String?
  province  String?
  zipCode   String?
  email     String?
  phone     String?
  website   String?
  logo      String?  // URL logo
  // Nuovi campi
  foundedYear        Int?
  president          String?
  colors             String[]
  registrationNumber String?
  bankAccount        String?
  socialLinks        Json?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relazioni
  users      User[]
  athletes   Athlete[]
  teams      Team[]
  documents  Document[]
  payments   Payment[]
  matches    Match[]
  trainings  TrainingSession[]
  // Nuove relazioni
  transportZones     TransportZone[]
  transportRoutes    TransportRoute[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  competitions       Competition[]
  venues             Venue[]
  staffMembers       StaffMember[]
  events             Event[]
  communications     Communication[]

  @@map("organizations")
}

// Utenti del sistema
model User {
  id             String    @id @default(uuid())
  email          String    @unique
  password       String
  firstName      String
  lastName       String
  phone          String?
  role           Role      @relation(fields: [roleId], references: [id])
  roleId         String
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  isActive       Boolean   @default(true)
  lastLogin      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relazioni
  uploadedDocuments Document[] @relation("UploadedBy")
  verifiedDocuments Document[] @relation("VerifiedBy")
  createdPayments   Payment[]  @relation("CreatedBy")
  // Nuove relazioni
  notifications     Notification[]
  auditLogs         AuditLog[]
  performanceScores PerformanceScore[] @relation("Evaluator")
  communications    Communication[]

  @@index([email])
  @@index([organizationId])
  @@map("users")
}

// Ruoli utente
model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  permissions Json     // Array di permessi
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relazioni
  users User[]

  @@map("roles")
}

// Atleti
model Athlete {
  id             String        @id @default(uuid())
  firstName      String
  lastName       String
  birthDate      DateTime
  birthPlace     String?
  nationality    String        @default("Italiana")
  fiscalCode     String?       @unique
  email          String?
  phone          String?
  address        String?
  city           String?
  province       String?
  zipCode        String?
  
  // Dati sportivi
  team           Team?         @relation(fields: [teamId], references: [id])
  teamId         String?
  position       Position?     @relation(fields: [positionId], references: [id])
  positionId     String?
  jerseyNumber   Int?
  status         AthleteStatus @default(ACTIVE)
  
  // Nuovi campi
  transportZone        TransportZone? @relation(fields: [transportZoneId], references: [id])
  transportZoneId      String?
  needsTransport       Boolean       @default(false)
  photoUrl             String?
  registrationNumber   String?
  contractEndDate      DateTime?
  socialMediaConsent   Boolean       @default(false)
  imageRightsConsent   Boolean       @default(false)
  
  // Dati genitori/tutori
  parentName     String?
  parentPhone    String?
  parentEmail    String?
  
  // Dati medici
  medicalNotes   String?
  allergies      String?
  
  organization   Organization  @relation(fields: [organizationId], references: [id])
  organizationId String
  
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Relazioni
  documents      Document[]
  payments       Payment[]
  attendances    TrainingAttendance[]
  matchRoster    MatchRoster[]
  matchStats     MatchStats[]
  injuries       Injury[]
  // Nuove relazioni
  transportBookings    TransportBooking[]
  performanceScores    PerformanceScore[]

  @@index([organizationId])
  @@index([teamId])
  @@index([fiscalCode])
  @@map("athletes")
}

// Stati atleta
enum AthleteStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  INJURED
}

// Squadre
model Team {
  id             String       @id @default(uuid())
  name           String
  category       String       // Es: "Under 15", "Prima Squadra"
  season         String       // Es: "2024/2025"
  coach          String?
  assistantCoach String?
  
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relazioni
  athletes       Athlete[]
  homeMatches    Match[]      @relation("HomeTeam")
  awayMatches    Match[]      @relation("AwayTeam")
  trainings      TrainingSession[]
  // Nuove relazioni
  staffMembers   StaffMember[]

  @@index([organizationId])
  @@map("teams")
}

// Posizioni di gioco
model Position {
  id          String    @id @default(uuid())
  name        String    @unique
  code        String    @unique // Es: "POR", "DIF", "CEN", "ATT"
  description String?

  // Relazioni
  athletes    Athlete[]

  @@map("positions")
}

// ==========================================
// GESTIONE DOCUMENTI
// ==========================================

// Tipi di documento
model DocumentType {
  id           Int        @id @default(autoincrement())
  name         String     @unique
  description  String?
  isRequired   Boolean    @default(false)
  hasExpiry    Boolean    @default(false)
  validityDays Int?       // Giorni di validità predefiniti

  // Relazioni
  documents    Document[]

  @@map("document_types")
}

// Documenti
model Document {
  id             String         @id @default(uuid())
  athlete        Athlete        @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  athleteId      String
  type           DocumentType   @relation(fields: [typeId], references: [id])
  typeId         Int
  fileName       String
  fileUrl        String
  fileSize       Int
  mimeType       String
  issueDate      DateTime?
  expiryDate     DateTime?
  status         DocumentStatus @default(VALID)
  notes          String?
  
  // Nuovi campi per reminder
  reminder30Days   Boolean        @default(false)
  reminder7Days    Boolean        @default(false)
  reminder1Day     Boolean        @default(false)
  
  // Tracking upload e verifica
  uploadedBy     User           @relation("UploadedBy", fields: [uploadedById], references: [id])
  uploadedById   String
  uploadedAt     DateTime       @default(now())
  isVerified     Boolean        @default(false)
  verifiedBy     User?          @relation("VerifiedBy", fields: [verifiedById], references: [id])
  verifiedById   String?
  verifiedAt     DateTime?
  
  organization   Organization   @relation(fields: [organizationId], references: [id])
  organizationId String
  
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([athleteId])
  @@index([organizationId])
  @@index([expiryDate])
  @@map("documents")
}

// Stati documento
enum DocumentStatus {
  VALID
  EXPIRING  // In scadenza (< 30 giorni)
  EXPIRED
}

// ==========================================
// GESTIONE PAGAMENTI
// ==========================================

// Tipi di pagamento
model PaymentType {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  amount      Float     @default(0)
  isRecurring Boolean   @default(false)
  frequency   String?   // MONTHLY, YEARLY, ONE_TIME
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relazioni
  payments    Payment[]

  @@map("payment_types")
}

// Pagamenti
model Payment {
  id             String         @id @default(uuid())
  organization   Organization   @relation(fields: [organizationId], references: [id])
  organizationId String
  athlete        Athlete        @relation(fields: [athleteId], references: [id])
  athleteId      String
  type           PaymentType    @relation(fields: [typeId], references: [id])
  typeId         Int
  amount         Float
  paidAmount     Float?         @default(0)
  dueDate        DateTime
  paidDate       DateTime?
  status         PaymentStatus  @default(PENDING)
  paymentMethod  String?
  description    String?
  notes          String?
  createdBy      User          @relation("CreatedBy", fields: [createdById], references: [id])
  createdById    String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId])
  @@index([athleteId])
  @@index([status])
  @@index([dueDate])
  @@map("payments")
}

// Stati pagamento
enum PaymentStatus {
  PENDING
  PAID
  PARTIAL
  OVERDUE
  CANCELLED
}

// ==========================================
// GESTIONE PARTITE E ALLENAMENTI
// ==========================================

// Partite
model Match {
  id              String       @id @default(uuid())
  homeTeam        Team         @relation("HomeTeam", fields: [homeTeamId], references: [id])
  homeTeamId      String
  awayTeam        Team         @relation("AwayTeam", fields: [awayTeamId], references: [id])
  awayTeamId      String
  date            DateTime
  time            String?      // Orario separato
  
  // Campi base
  venue           String?
  
  // Nuovi campi
  competition     Competition? @relation(fields: [competitionId], references: [id])
  competitionId   String?
  venueDetails    Venue?       @relation(fields: [venueId], references: [id])
  venueId         String?
  referees        String[]
  weatherConditions String?
  spectators      Int?
  incomeGenerated Float?
  
  homeScore       Int?
  awayScore       Int?
  status          MatchStatus  @default(SCHEDULED)
  notes           String?
  
  organization    Organization @relation(fields: [organizationId], references: [id])
  organizationId  String
  
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Relazioni
  roster          MatchRoster[]
  stats           MatchStats[]
  transportSchedules TransportSchedule[]

  @@index([organizationId])
  @@index([date])
  @@map("matches")
}

// Stati partita
enum MatchStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  POSTPONED
}

// Convocazioni partita
model MatchRoster {
  id        String   @id @default(uuid())
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchId   String
  athlete   Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  athleteId String
  isStarter Boolean  @default(false)
  attended  Boolean  @default(false)
  notes     String?
  
  // Nuovi campi per convocazioni avanzate
  convocationStatus String    @default("PENDING")
  responseDate      DateTime?
  absenceReason     String?

  @@unique([matchId, athleteId])
  @@map("match_rosters")
}

// Statistiche partita per atleta
model MatchStats {
  id          String  @id @default(uuid())
  match       Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchId     String
  athlete     Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  athleteId   String
  minutesPlayed Int   @default(0)
  goals       Int     @default(0)
  assists     Int     @default(0)
  yellowCards Int     @default(0)
  redCards    Int     @default(0)
  notes       String?

  @@unique([matchId, athleteId])
  @@map("match_stats")
}

// Sessioni di allenamento
model TrainingSession {
  id             String       @id @default(uuid())
  team           Team         @relation(fields: [teamId], references: [id])
  teamId         String
  date           DateTime
  startTime      String
  endTime        String
  location       String?
  type           String?      // TECHNICAL, TACTICAL, PHYSICAL
  description    String?
  
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relazioni
  attendances    TrainingAttendance[]
  transportSchedules TransportSchedule[]

  @@index([teamId])
  @@index([date])
  @@map("training_sessions")
}

// Presenze allenamento
model TrainingAttendance {
  id        String          @id @default(uuid())
  session   TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  athlete   Athlete         @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  athleteId String
  present   Boolean         @default(false)
  reason    String?         // Motivo assenza
  notes     String?

  @@unique([sessionId, athleteId])
  @@map("training_attendances")
}

// ==========================================
// GESTIONE INFORTUNI
// ==========================================

model Injury {
  id           String    @id @default(uuid())
  athlete      Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  athleteId    String
  injuryDate   DateTime
  description  String
  severity     String?   // MILD, MODERATE, SEVERE
  estimatedRecovery Int? // Giorni stimati di recupero
  isRecovered  Boolean   @default(false)
  recoveryDate DateTime?
  notes        String?
  
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([athleteId])
  @@map("injuries")
}

// ==========================================
// SISTEMA TRASPORTI (NUOVO)
// ==========================================

model TransportZone {
  id             String       @id @default(uuid())
  name           String
  description    String?
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relazioni
  athletes       Athlete[]

  @@map("transport_zones")
}

model TransportRoute {
  id             String       @id @default(uuid())
  name           String
  driver         String?
  vehiclePlate   String?
  capacity       Int          @default(8)
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relazioni
  schedules      TransportSchedule[]

  @@map("transport_routes")
}

model TransportSchedule {
  id         String           @id @default(uuid())
  route      TransportRoute   @relation(fields: [routeId], references: [id])
  routeId    String
  match      Match?           @relation(fields: [matchId], references: [id])
  matchId    String?
  session    TrainingSession? @relation(fields: [sessionId], references: [id])
  sessionId  String?
  pickupTime DateTime
  returnTime DateTime?
  status     String           @default("SCHEDULED")
  notes      String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  // Relazioni
  bookings   TransportBooking[]

  @@map("transport_schedules")
}

model TransportBooking {
  id          String            @id @default(uuid())
  athlete     Athlete           @relation(fields: [athleteId], references: [id])
  athleteId   String
  schedule    TransportSchedule @relation(fields: [scheduleId], references: [id])
  scheduleId  String
  status      String            @default("CONFIRMED")
  pickupPoint String?
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([athleteId, scheduleId])
  @@map("transport_bookings")
}

// ==========================================
// SISTEMA NOTIFICHE (NUOVO)
// ==========================================

model Notification {
  id             String       @id @default(uuid())
  user           User?        @relation(fields: [userId], references: [id])
  userId         String?
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  type           String
  title          String
  message        String
  link           String?
  priority       String       @default("normal")
  isRead         Boolean      @default(false)
  readAt         DateTime?
  data           Json?
  createdAt      DateTime     @default(now())

  @@index([userId])
  @@index([organizationId])
  @@index([isRead])
  @@map("notifications")
}

// ==========================================
// AUDIT LOG (NUOVO)
// ==========================================

model AuditLog {
  id             String       @id @default(uuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  user           User         @relation(fields: [userId], references: [id])
  userId         String
  action         String
  entityType     String
  entityId       String
  oldValues      Json?
  newValues      Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([userId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ==========================================
// COMPETIZIONI E VENUE (NUOVO)
// ==========================================

model Competition {
  id             String       @id @default(uuid())
  name           String
  type           String
  season         String
  startDate      DateTime
  endDate        DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relazioni
  matches        Match[]

  @@map("competitions")
}

model Venue {
  id             String       @id @default(uuid())
  name           String
  address        String
  city           String
  province       String?
  capacity       Int?
  type           String       @default("STANDARD")
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relazioni
  matches        Match[]

  @@map("venues")
}

// ==========================================
// STAFF TECNICO (NUOVO)
// ==========================================

model StaffMember {
  id             String       @id @default(uuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  firstName      String
  lastName       String
  role           String
  team           Team?        @relation(fields: [teamId], references: [id])
  teamId         String?
  email          String?
  phone          String?
  qualifications String?
  contractEnd    DateTime?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("staff_members")
}

// ==========================================
// PERFORMANCE SCORES (NUOVO)
// ==========================================

model PerformanceScore {
  id          String   @id @default(uuid())
  athlete     Athlete  @relation(fields: [athleteId], references: [id])
  athleteId   String
  date        DateTime
  type        String
  score       Float
  metrics     Json?
  evaluator   User?    @relation("Evaluator", fields: [evaluatorId], references: [id])
  evaluatorId String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([athleteId])
  @@map("performance_scores")
}

// ==========================================
// EVENTI (NUOVO)
// ==========================================

model Event {
  id              String       @id @default(uuid())
  organization    Organization @relation(fields: [organizationId], references: [id])
  organizationId  String
  type            String
  title           String
  description     String?
  date            DateTime
  endDate         DateTime?
  location        String?
  maxParticipants Int?
  isPublic        Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([date])
  @@map("events")
}

// ==========================================
// COMUNICAZIONI (NUOVO)
// ==========================================

model Communication {
  id             String       @id @default(uuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  fromUser       User         @relation(fields: [fromUserId], references: [id])
  fromUserId     String
  toUsers        String[]
  toGroups       String[]
  subject        String
  message        String
  type           String       @default("EMAIL")
  status         String       @default("PENDING")
  sentAt         DateTime?
  errorMessage   String?
  createdAt      DateTime     @default(now())

  @@index([status])
  @@map("communications")
}
