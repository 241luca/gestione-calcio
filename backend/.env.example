# ESEMPIO di configurazione - COPIA questo file come .env e modifica i valori

# Configurazione Database
DATABASE_URL="postgresql://tuousername@localhost:5432/soccer_management"

# Configurazione Server
PORT=3000
NODE_ENV=development

# JWT Secret (cambia questa chiave in produzione!)
JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=24h

# CORS
CORS_ORIGIN=http://localhost:5173

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads
